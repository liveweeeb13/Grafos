{
  "manifest_version": 3,
  "name": "Grafos",
  "version": "1.4.1",
  "description": "Drawing on web pages",
  "author": "liveweeeb",
  "permissions": ["storage", "activeTab"],
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "core/core.js",
        "canvas/canvas.js",
        "canvas/drawing.js",
        "storage/storage.js",
        "tools/brush.js",
        "tools/eraser.js",
        "tools/text.js",
        "ui/controls.js",
        "ui/text-editor.js",
        "ui/draggable.js",
        "ui/main.js"
      ],
      "css": ["styles/style.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grafos@liveweeeb.com",
      "strict_min_version": "109.0"
    }
  }
}